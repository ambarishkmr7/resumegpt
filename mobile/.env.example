# Backend origin. Leave unset in dev: Android emulator defaults to
# http://10.0.2.2:8000 and iOS simulator to http://localhost:8000.
# Set to the deployed backend for production builds (must be https).
EXPO_PUBLIC_API_BASE=

# Google Sign-In (optional). Must equal the backend's GOOGLE_CLIENT_ID —
# the backend verifies the idToken audience against it. Also requires an
# Android OAuth client (package com.resumesgpt.app + debug/release SHA-1)
# in the same Google Cloud project.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Set to "production" to disable cleartext HTTP in the Android build.
APP_VARIANT=
